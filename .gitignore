# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# internal audit reports + QA test artifacts/tooling (not part of the app)
/audit/
scripts/qa-*

# Raw / intermediate hero-video masters — delivered via Cloudinary, never via git.
# (The optimized /public derivative + poster ARE committed; these masters are not.)
media-source/*.mp4
